              "threats": [
                {
                  "id": "06f5010d-fc21-4a96-aee5-64f885ba4d88",
                  "title": "Unauthorized Modification of Database Records",
                  "status": "Mitigated",
                  "severity": "Low",
                  "type": "Tampering",
                  "description": "An attacker could alter, insert, or delete SQL database records by exploiting insufficient input validation, SQL injection vulnerabilities, or an overprivileged database account. This could compromise the integrity and reliability of application data.",
                  "mitigation": "Use parameterized queries and prepared statements for all database operations. Apply least-privilege database permissions, validate server-side input, restrict write access by role, and maintain audit logs and integrity monitoring to detect unauthorized changes.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": ""
                },
                {
                  "id": "1e7373db-7ff3-4373-99de-902b56f544db",
                  "title": "Exposure of Sensitive Database Information",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "An attacker who gains unauthorized database access could view sensitive user or application information. Weak access controls, excessive database permissions, unencrypted data, or exposed backups could result in a serious confidentiality breach.",
                  "mitigation": "Planned mitigations include encrypting sensitive data at rest and in transit, enforcing role-based access control and least privilege, securing database backups, rotating credentials, and monitoring access logs for suspicious activity. These controls have not yet been fully implemented.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": ""
                },
                {
                  "id": "ce7dba83-423d-4e98-876a-dc6a60cca73a",
                  "title": "Database Resource Exhaustion",
                  "status": "Mitigated",
                  "severity": "Medium",
                  "type": "Denial of service",
                  "description": "An attacker could send excessive or computationally expensive database requests that consume connections, memory, CPU, or storage. This could slow the application or make the database unavailable to legitimate users.",
                  "mitigation": "Use rate limiting, query timeouts, connection-pool limits, and resource quotas. Monitor database performance and alert on unusual traffic or resource consumption. Restrict expensive operations and maintain tested backup and recovery procedures.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": ""
                }
              ],
              "threatFrequency": {
                "tampering": 1,
                "repudiation": 0,
                "informationDisclosure": 1,
                "denialOfService": 1
              }
            }
